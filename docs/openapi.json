  "components": {
    "schemas": {
      "AeonPolicyOverride": {
        "properties": {
          "quality_target": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality Target",
            "description": "Minimum acceptable quality threshold (0.0 to 1.0)"
          },
          "latency_sla_ms": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Sla Ms",
            "description": "Strict SLA latency limit in milliseconds"
          },
          "cost_budget_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Budget Usd",
            "description": "Maximum allowed monetary cost in USD"
          },
          "memory_budget_mb": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory Budget Mb",
            "description": "Maximum allowable memory footprint in MB"
          },
          "energy_budget_joules": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Energy Budget Joules",
            "description": "Maximum allowable energy consumption in Joules"
          },
          "preferred_device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Device",
            "description": "Preferred hardware accelerator (e.g. cpu, mps, cuda)"
          },
          "preferred_precision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Precision",
            "description": "Preferred numerical precision (e.g. fp32, fp16, fp8, int8)"
          },
          "preferred_quantization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Quantization",
            "description": "Preferred quantization method (e.g. none, int8, int4)"
          },
          "memory": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory",
            "description": "Toggle Phase 3 multi-tier memory hierarchy"
          },
          "tools": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tools",
            "description": "Toggle Phase 4 deterministic tool routing"
          },
          "speculation": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speculation",
            "description": "Toggle Phase 5 speculative decoding"
          },
          "reasoning": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning",
            "description": "Toggle Phase 6 adaptive reasoning controller"
          },
          "adaptive_depth": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptive Depth",
            "description": "Toggle Phase 7 adaptive depth early exit"
          },
          "hardware_aware": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hardware Aware",
            "description": "Toggle Phase 8 hardware-aware execution"
          }
        },
        "type": "object",
        "title": "AeonPolicyOverride",
        "description": "Namespaced per-request optimization constraints and overrides."
      },
      "AeonTelemetryMetadata": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "selected_model": {
            "type": "string",
            "title": "Selected Model"
          },
          "selected_device": {
            "type": "string",
            "title": "Selected Device"
          },
          "selected_precision": {
            "type": "string",
            "title": "Selected Precision"
          },
          "selected_depth": {
            "type": "integer",
            "title": "Selected Depth"
          },
          "selected_strategy": {
            "type": "string",
            "title": "Selected Strategy"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          },
          "tool_used": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Used"
          },
          "reasoning_strategy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Strategy"
          },
          "speculation_used": {
            "type": "boolean",
            "title": "Speculation Used",
            "default": false
          },
          "quality_estimate": {
            "type": "number",
            "title": "Quality Estimate"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "estimated_cost_usd": {
            "type": "number",
            "title": "Estimated Cost Usd"
          },
          "estimated_energy_joules": {
            "type": "number",
            "title": "Estimated Energy Joules"
          },
          "controller_overhead_ms": {
            "type": "number",
            "title": "Controller Overhead Ms"
          },
          "provenance": {
            "type": "string",
            "title": "Provenance",
            "default": "HYBRID"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "selected_model",
          "selected_device",
          "selected_precision",
          "selected_depth",
          "selected_strategy",
          "cache_hit",
          "quality_estimate",
          "latency_ms",
          "estimated_cost_usd",
          "estimated_energy_joules",
          "controller_overhead_ms"
        ],
        "title": "AeonTelemetryMetadata",
        "description": "Non-intrusive metadata exposed via x_aeon without violating OpenAI schema compatibility."
      },
      "ChatChoice": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index",
            "default": 0
          },
          "message": {
            "$ref": "#/components/schemas/ChatChoiceMessage"
          },
          "finish_reason": {
            "type": "string",
            "title": "Finish Reason",
            "default": "stop"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatChoice",
        "description": "Individual completion choice."
      },
      "ChatChoiceMessage": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "default": "assistant"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "ChatChoiceMessage",
        "description": "Output message generated by the model."
      },
      "ChatCompletionRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Model identifier (e.g. 'aeon-auto', 'aeon-small', 'aeon-medium')",
            "default": "aeon-auto"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "minItems": 1,
            "title": "Messages",
            "description": "List of messages comprising the conversation so far"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature",
            "description": "Sampling temperature",
            "default": 0.0
          },
          "top_p": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top P",
            "description": "Nucleus sampling probability",
            "default": 1.0
          },
          "n": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "N",
            "description": "Number of completions (currently 1 supported)",
            "default": 1
          },
          "stream": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stream",
            "description": "Whether to stream response chunks via Server-Sent Events",
            "default": false
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8192.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens",
            "description": "Maximum tokens to generate",
            "default": 256
          },
          "presence_penalty": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": -2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Presence Penalty",
            "default": 0.0
          },
          "frequency_penalty": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": -2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Frequency Penalty",
            "default": 0.0
          },
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User",
            "description": "A unique identifier representing your end-user"
          },
          "extra_body": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExtraBody"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional extra body for AEON configuration"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatCompletionRequest",
        "description": "OpenAI-compatible chat completion request schema."
      },
      "ChatCompletionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "chat.completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/ChatChoice"
            },
            "type": "array",
            "title": "Choices"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInfo"
          },
          "x_aeon": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AeonTelemetryMetadata"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "model",
          "choices",
          "usage"
        ],
        "title": "ChatCompletionResponse",
        "description": "Standard OpenAI-compatible Chat Completion response."
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool",
              "function"
            ],
            "title": "Role",
            "description": "Role of the message author"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The message contents"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Optional author participant name"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "description": "Standard conversational message."
      },
      "ComponentHealth": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "status",
          "available"
        ],
        "title": "ComponentHealth"
      },
      "DashboardSummary": {
        "properties": {
          "system": {
            "$ref": "#/components/schemas/SystemInfo"
          },
          "metrics": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metrics"
          },
          "provenance": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Provenance"
          }
        },
        "type": "object",
        "required": [
          "system",
          "metrics",
          "provenance"
        ],
        "title": "DashboardSummary"
      },
